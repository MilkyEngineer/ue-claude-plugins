<Project>
	<!--
		Copyright Alex Stevens (@MilkyEngineer). All Rights Reserved.

		References the engine's prebuilt EpicGames.* assemblies (DESIGN.md, "Engine libraries"). Imported by Directory.Build.props,
		so every project in the kit gets them.

		The engine comes from, in order:
		  1. the UakEngineDir property (dotnet build -p:UakEngineDir=<path>);
		  2. the UAK_ENGINE environment variable;
		  3. the engine whose bundled .NET SDK runs this build (<Root>/Engine/Binaries/ThirdParty/DotNet/<version>/<platform>/dotnet).
		Each may be the engine root (the directory holding Engine/Build/Build.version) or its Engine folder.

		The EpicGames.* assemblies and their third-party dependencies are all file references into the engine, copied to the
		output (Private=true): no NuGet package is needed, and the versions are always the ones the engine was built with.
		Nothing is ever written into the engine directory.
	-->
	<PropertyGroup>
		<_UakEngineCandidate>$(UakEngineDir)</_UakEngineCandidate>
		<_UakEngineSource Condition="'$(_UakEngineCandidate)' != ''">UakEngineDir property</_UakEngineSource>
		<_UakEngineCandidate Condition="'$(_UakEngineCandidate)' == ''">$(UAK_ENGINE)</_UakEngineCandidate>
		<_UakEngineSource Condition="'$(_UakEngineSource)' == '' and '$(_UakEngineCandidate)' != ''">UAK_ENGINE environment variable</_UakEngineSource>
		<!--
			MSBuildBinPath is the running SDK's folder, <dotnet>/sdk/<sdk version>/, and a bundled dotnet sits in
			<Root>/Engine/Binaries/ThirdParty/DotNet/<version>/<platform>/, so seven levels up is <Root>/Engine.
			NetCoreRoot is not defined yet when Directory.Build.props is imported.
		-->
		<_UakSdkEngineDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildBinPath)', '..', '..', '..', '..', '..', '..', '..'))))</_UakSdkEngineDir>
		<_UakEngineCandidate Condition="'$(_UakEngineCandidate)' == '' and Exists('$(_UakSdkEngineDir)/Build/Build.version')">$(_UakSdkEngineDir)</_UakEngineCandidate>
		<_UakEngineSource Condition="'$(_UakEngineSource)' == '' and '$(_UakEngineCandidate)' != ''">the engine that bundles the running .NET SDK</_UakEngineSource>

		<!-- Accept either the root or its Engine folder. -->
		<UakEngineRoot Condition="'$(_UakEngineCandidate)' != '' and Exists('$(_UakEngineCandidate)/Engine/Build/Build.version')">$([System.IO.Path]::GetFullPath('$(_UakEngineCandidate)'))</UakEngineRoot>
		<UakEngineRoot Condition="'$(UakEngineRoot)' == '' and '$(_UakEngineCandidate)' != '' and Exists('$(_UakEngineCandidate)/Build/Build.version')">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_UakEngineCandidate)', '..'))))</UakEngineRoot>
		<UakEngineRoot Condition="'$(UakEngineRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(UakEngineRoot)'))</UakEngineRoot>

		<!-- UnrealBuildTool's folder ships EpicGames.Core and EpicGames.Build in 5.8; AutomationTool's is the fallback. -->
		<UakEpicGamesDir Condition="'$(UakEngineRoot)' != '' and Exists('$(UakEngineRoot)Engine/Binaries/DotNET/UnrealBuildTool/EpicGames.Build.dll')">$(UakEngineRoot)Engine/Binaries/DotNET/UnrealBuildTool/</UakEpicGamesDir>
		<UakEpicGamesDir Condition="'$(UakEpicGamesDir)' == '' and '$(UakEngineRoot)' != '' and Exists('$(UakEngineRoot)Engine/Binaries/DotNET/AutomationTool/EpicGames.Build.dll')">$(UakEngineRoot)Engine/Binaries/DotNET/AutomationTool/</UakEpicGamesDir>

		<!--
			The engine's .NET version, from the "tfm" of the runtimeconfig.json next to its EpicGames.* assemblies (UE 5.8: net10.0,
			UE 5.7: net8.0). Directory.Build.props targets it, so those assemblies load. Empty when it can't be read.
		-->
		<_UakRuntimeConfig Condition="'$(UakEpicGamesDir)' != '' and Exists('$(UakEpicGamesDir)UnrealBuildTool.runtimeconfig.json')">$(UakEpicGamesDir)UnrealBuildTool.runtimeconfig.json</_UakRuntimeConfig>
		<_UakRuntimeConfig Condition="'$(UakEpicGamesDir)' != '' and '$(_UakRuntimeConfig)' == '' and Exists('$(UakEpicGamesDir)AutomationTool.runtimeconfig.json')">$(UakEpicGamesDir)AutomationTool.runtimeconfig.json</_UakRuntimeConfig>
		<_UakEngineTfm Condition="'$(_UakRuntimeConfig)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(_UakRuntimeConfig)')), '(?s)^.*"tfm"\s*:\s*"(net\d+\.\d+)".*$', '$1'))</_UakEngineTfm>
		<UakEngineTargetFramework Condition="'$(UakEngineTargetFramework)' == '' and '$(_UakEngineTfm)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_UakEngineTfm)', '^net\d+\.\d+$'))">$(_UakEngineTfm)</UakEngineTargetFramework>

		<!--
			When the engine's runtimeconfig.json can't be read, the running SDK's own .NET: its major version, from MSBuildBinPath's
			<dotnet>/sdk/<sdk version>/ folder name (SDK 10.0.203: net10.0; SDK 8.0.412: net8.0). That SDK can always build for it.
		-->
		<_UakSdkTfm>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildBinPath)', '(?s)^.*[/\\]sdk[/\\](\d+)\.[^/\\]*[/\\]?$', 'net$1.0'))</_UakSdkTfm>
		<UakSdkTargetFramework Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_UakSdkTfm)', '^net\d+\.0$'))">$(_UakSdkTfm)</UakSdkTargetFramework>

		<!-- The engine's version, Major.Minor.Patch from its Build.version: `uak env` shows it, and EpicGames.Perforce.FromSource is versioned by it. -->
		<_UakBuildVersion Condition="'$(UakEngineRoot)' != '' and Exists('$(UakEngineRoot)Engine/Build/Build.version')">$([System.IO.File]::ReadAllText('$(UakEngineRoot)Engine/Build/Build.version'))</_UakBuildVersion>
		<_UakEngineMajor Condition="'$(_UakBuildVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_UakBuildVersion)', '(?s)^.*"MajorVersion"\s*:\s*(\d+).*$', '$1'))</_UakEngineMajor>
		<_UakEngineMinor Condition="'$(_UakBuildVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_UakBuildVersion)', '(?s)^.*"MinorVersion"\s*:\s*(\d+).*$', '$1'))</_UakEngineMinor>
		<_UakEnginePatch Condition="'$(_UakBuildVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_UakBuildVersion)', '(?s)^.*"PatchVersion"\s*:\s*(\d+).*$', '$1'))</_UakEnginePatch>
		<UakEngineVersion Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_UakEngineMajor).$(_UakEngineMinor).$(_UakEnginePatch)', '^\d+\.\d+\.\d+$'))">$(_UakEngineMajor).$(_UakEngineMinor).$(_UakEnginePatch)</UakEngineVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(UakEngineVersion)' != ''">
		<!-- Read by `uak env` (EnvCommand.BuiltEngineVersion). -->
		<AssemblyMetadata Include="UakEngineVersion" Value="$(UakEngineVersion)" />
	</ItemGroup>

	<ItemGroup Condition="'$(UakEpicGamesDir)' != ''">
		<!-- EpicGames.Build needs EpicGames.IoHash and EpicGames.MsBuild at run time. -->
		<Reference Include="EpicGames.Core" HintPath="$(UakEpicGamesDir)EpicGames.Core.dll" Private="true" />
		<Reference Include="EpicGames.Build" HintPath="$(UakEpicGamesDir)EpicGames.Build.dll" Private="true" />
		<Reference Include="EpicGames.IoHash" HintPath="$(UakEpicGamesDir)EpicGames.IoHash.dll" Private="true" />
		<Reference Include="EpicGames.MsBuild" HintPath="$(UakEpicGamesDir)EpicGames.MsBuild.dll" Private="true" />

		<!--
			Their run-time dependency closure (UnrealBuildTool.deps.json; the same in UE 5.7 and 5.8), from the same folder, so the
			versions always match the engine. UE 5.7 also lists System.Drawing.Common, System.Security.Permissions and their
			Windows-only helpers, for EpicGames.MsBuild code that uak never calls; and Microsoft.Build, which MSBuildLocator loads
			from an SDK.
		-->
		<Reference Include="Blake3" HintPath="$(UakEpicGamesDir)Blake3.dll" Private="true" />
		<Reference Include="JetBrains.Annotations" HintPath="$(UakEpicGamesDir)JetBrains.Annotations.dll" Private="true" />
		<Reference Include="Microsoft.Build.Locator" HintPath="$(UakEpicGamesDir)Microsoft.Build.Locator.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Configuration" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Configuration.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Configuration.Abstractions" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Configuration.Abstractions.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Configuration.Binder" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Configuration.Binder.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.DependencyInjection" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.DependencyInjection.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Diagnostics" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Diagnostics.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Diagnostics.Abstractions" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Diagnostics.Abstractions.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.FileSystemGlobbing" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.FileSystemGlobbing.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Http" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Http.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Http.Polly" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Http.Polly.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Logging" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Logging.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Logging.Abstractions" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Logging.Abstractions.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Logging.Configuration" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Logging.Configuration.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Logging.Console" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Logging.Console.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.ObjectPool" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.ObjectPool.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Options" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Options.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Options.ConfigurationExtensions" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Options.ConfigurationExtensions.dll" Private="true" />
		<Reference Include="Microsoft.Extensions.Primitives" HintPath="$(UakEpicGamesDir)Microsoft.Extensions.Primitives.dll" Private="true" />
		<Reference Include="OpenTracing" HintPath="$(UakEpicGamesDir)OpenTracing.dll" Private="true" />
		<Reference Include="Polly" HintPath="$(UakEpicGamesDir)Polly.dll" Private="true" />
		<Reference Include="Polly.Extensions.Http" HintPath="$(UakEpicGamesDir)Polly.Extensions.Http.dll" Private="true" />

		<!-- Blake3's native library for the target platform, next to uak, where .NET looks for it. -->
		<_UakNativeLibrary Include="$(UakEpicGamesDir)runtimes/$(RuntimeIdentifier)/native/*blake3_dotnet*" Condition="'$(RuntimeIdentifier)' != ''" />
		<_UakNativeLibrary Include="$(UakEpicGamesDir)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*blake3_dotnet*" Condition="'$(RuntimeIdentifier)' == ''" />
		<None Include="@(_UakNativeLibrary)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<Target Name="UakCheckEngine" BeforeTargets="ResolveAssemblyReferences;CollectPackageReferences">
		<Error Condition="'$(_UakEngineCandidate)' == ''"
			Text="UnrealAgentKit needs an Unreal Engine to reference its EpicGames.* assemblies. Build with the engine's bundled dotnet (&lt;Engine&gt;/Binaries/ThirdParty/DotNet/&lt;version&gt;/&lt;platform&gt;/dotnet), or pass -p:UakEngineDir=&lt;engine root&gt;, or set UAK_ENGINE." />
		<Error Condition="'$(_UakEngineCandidate)' != '' and '$(UakEngineRoot)' == ''"
			Text="UnrealAgentKit: '$(_UakEngineCandidate)' (from the $(_UakEngineSource)) is not an engine: no Engine/Build/Build.version under it." />
		<Error Condition="'$(UakEngineRoot)' != '' and '$(UakEpicGamesDir)' == ''"
			Text="UnrealAgentKit: no prebuilt EpicGames.Build.dll in '$(UakEngineRoot)Engine/Binaries/DotNET/UnrealBuildTool' or '.../AutomationTool'. Build UnrealBuildTool for that engine first." />
	</Target>
</Project>
