<Project>
	<!--
		Copyright Alex Stevens (@MilkyEngineer). All Rights Reserved.

		References the engine's prebuilt EpicGames.Perforce.dll (DESIGN.md, "Engine libraries"). Imported by AgentKit.Vcs and
		its tests only; build/EpicGames.props (Core) resolves the engine into UakEngineRoot first.

		Installed engines ship EpicGames.Perforce with AutomationTool: in AutomationTool/AutomationUtils/<tfm>/ in 5.8 (net10.0),
		and directly in AutomationTool/AutomationUtils/ in 5.7. The folder matching our TargetFramework is preferred, then the
		flat folder. -p:UakPerforceDll=<path> overrides both.
		Only PerforceConnection (which runs `p4 -G`) is used, so EpicGames.Perforce.Native is not needed.
		Its one third-party dependency is OpenTelemetry.Api in UE 5.8 (next to it), and System.Linq.Async in UE 5.7 (in
		AutomationTool/). Both are referenced from the engine too. Only 5.8's IPerforceConnection has a Tracer, so
		UAK_PERFORCE_TRACER is defined when OpenTelemetry.Api is there.
		The build fails when the DLL cannot be found: we never build silently without Perforce support.
	-->
	<PropertyGroup>
		<_UakAutomationToolDir Condition="'$(UakEngineRoot)' != ''">$(UakEngineRoot)Engine/Binaries/DotNET/AutomationTool/</_UakAutomationToolDir>
		<_UakAutomationUtilsDir Condition="'$(UakEngineRoot)' != ''">$(_UakAutomationToolDir)AutomationUtils/</_UakAutomationUtilsDir>
		<UakPerforceDll Condition="'$(UakPerforceDll)' == '' and '$(_UakAutomationUtilsDir)' != '' and Exists('$(_UakAutomationUtilsDir)$(TargetFramework)/EpicGames.Perforce.dll')">$(_UakAutomationUtilsDir)$(TargetFramework)/EpicGames.Perforce.dll</UakPerforceDll>
		<UakPerforceDll Condition="'$(UakPerforceDll)' == '' and '$(_UakAutomationUtilsDir)' != '' and Exists('$(_UakAutomationUtilsDir)EpicGames.Perforce.dll')">$(_UakAutomationUtilsDir)EpicGames.Perforce.dll</UakPerforceDll>
		<_UakPerforceDir Condition="'$(UakPerforceDll)' != ''">$([System.IO.Path]::GetDirectoryName('$(UakPerforceDll)'))/</_UakPerforceDir>
		<DefineConstants Condition="'$(_UakPerforceDir)' != '' and Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll')">$(DefineConstants);UAK_PERFORCE_TRACER</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(UakPerforceDll)' != ''">
		<Reference Include="EpicGames.Perforce" HintPath="$(UakPerforceDll)" Private="true" />
		<Reference Include="OpenTelemetry.Api" HintPath="$(_UakPerforceDir)OpenTelemetry.Api.dll" Private="true" Condition="Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll')" />
		<Reference Include="System.Linq.Async" HintPath="$(_UakAutomationToolDir)System.Linq.Async.dll" Private="true" Condition="!Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll') and Exists('$(_UakAutomationToolDir)System.Linq.Async.dll')" />
	</ItemGroup>

	<Target Name="UakCheckPerforce" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UakPerforceDll)' == '' and '$(UakEngineRoot)' != ''">
		<Error Text="UnrealAgentKit: no prebuilt EpicGames.Perforce.dll in '$(_UakAutomationUtilsDir)$(TargetFramework)/' or '$(_UakAutomationUtilsDir)'. Build AutomationTool for that engine first, or pass -p:UakPerforceDll=&lt;path&gt;." />
	</Target>
</Project>
