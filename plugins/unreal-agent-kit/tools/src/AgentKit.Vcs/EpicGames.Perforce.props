<Project>
	<!--
		Copyright Alex Stevens (@MilkyEngineer). All Rights Reserved.

		References the engine's EpicGames.Perforce (DESIGN.md, "Engine libraries"). Imported by AgentKit.Vcs and its tests only;
		build/EpicGames.props (Core) resolves the engine into UakEngineRoot first.

		Installed engines ship EpicGames.Perforce prebuilt with AutomationTool: in AutomationTool/AutomationUtils/<tfm>/ in 5.8
		(net10.0), and directly in AutomationTool/AutomationUtils/ in 5.7. The folder matching our TargetFramework is preferred,
		then the flat folder. -p:UakPerforceDll=<path> overrides both.
		A source build has no AutomationTool until someone builds it, so when there is no prebuilt DLL the kit compiles the
		engine's EpicGames.Perforce source itself (src/EpicGames.Perforce.FromSource), into the kit's own output.
		Only PerforceConnection (which runs `p4 -G`) is used, so EpicGames.Perforce.Native is not needed.
		Its one third-party dependency comes from the engine too: OpenTelemetry.Api in UE 5.8, System.Linq.Async before that.
		With the prebuilt DLL, that is the one beside it (5.8) or AutomationTool's (5.7); from source, the first found in the
		engine's UnrealBuildTool/, AutomationTool/, AutomationTool/AutomationUtils/ and AutomationUtils/<tfm>/
		(EpicGames.Perforce.FromSource/Dependencies.props, which fails early when 5.8's OpenTelemetry.Api is missing).
		Only 5.8's IPerforceConnection has a Tracer, so UAK_PERFORCE_TRACER is defined when the engine's IPerforceConnection
		uses OpenTelemetry.
		The build fails when neither the DLL nor the source can be found: we never build silently without Perforce support.
	-->
	<PropertyGroup>
		<_UakAutomationToolDir Condition="'$(UakEngineRoot)' != ''">$(UakEngineRoot)Engine/Binaries/DotNET/AutomationTool/</_UakAutomationToolDir>
		<_UakAutomationUtilsDir Condition="'$(UakEngineRoot)' != ''">$(_UakAutomationToolDir)AutomationUtils/</_UakAutomationUtilsDir>
		<UakPerforceDll Condition="'$(UakPerforceDll)' == '' and '$(_UakAutomationUtilsDir)' != '' and Exists('$(_UakAutomationUtilsDir)$(TargetFramework)/EpicGames.Perforce.dll')">$(_UakAutomationUtilsDir)$(TargetFramework)/EpicGames.Perforce.dll</UakPerforceDll>
		<UakPerforceDll Condition="'$(UakPerforceDll)' == '' and '$(_UakAutomationUtilsDir)' != '' and Exists('$(_UakAutomationUtilsDir)EpicGames.Perforce.dll')">$(_UakAutomationUtilsDir)EpicGames.Perforce.dll</UakPerforceDll>
		<_UakPerforceDir Condition="'$(UakPerforceDll)' != ''">$([System.IO.Path]::GetDirectoryName('$(UakPerforceDll)'))/</_UakPerforceDir>
		<DefineConstants Condition="'$(_UakPerforceDir)' != '' and Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll')">$(DefineConstants);UAK_PERFORCE_TRACER</DefineConstants>

		<!-- No prebuilt DLL: compile the engine's source. -->
		<_UakPerforceSource Condition="'$(UakPerforceDll)' == '' and '$(UakEngineRoot)' != ''">$(UakEngineRoot)Engine/Source/Programs/Shared/EpicGames.Perforce/IPerforceConnection.cs</_UakPerforceSource>
		<UakPerforceFromSource Condition="'$(_UakPerforceSource)' != '' and Exists('$(_UakPerforceSource)')">true</UakPerforceFromSource>
	</PropertyGroup>

	<!-- UakLinqAsyncDll, UakOpenTelemetryDll and UakPerforceSourceUsesOpenTelemetry, for the source fallback. -->
	<Import Project="$(MSBuildThisFileDirectory)..\EpicGames.Perforce.FromSource\Dependencies.props" />

	<PropertyGroup>
		<DefineConstants Condition="'$(UakPerforceFromSource)' == 'true' and '$(UakPerforceSourceUsesOpenTelemetry)' == 'true'">$(DefineConstants);UAK_PERFORCE_TRACER</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(UakPerforceDll)' != ''">
		<Reference Include="EpicGames.Perforce" HintPath="$(UakPerforceDll)" Private="true" />
		<Reference Include="OpenTelemetry.Api" HintPath="$(_UakPerforceDir)OpenTelemetry.Api.dll" Private="true" Condition="Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll')" />
		<Reference Include="System.Linq.Async" HintPath="$(_UakAutomationToolDir)System.Linq.Async.dll" Private="true" Condition="!Exists('$(_UakPerforceDir)OpenTelemetry.Api.dll') and Exists('$(_UakAutomationToolDir)System.Linq.Async.dll')" />
	</ItemGroup>

	<ItemGroup Condition="'$(UakPerforceFromSource)' == 'true'">
		<!-- Built in this build's configuration (and see ShouldUnsetParentConfigurationAndPlatform in Directory.Build.props). -->
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\EpicGames.Perforce.FromSource\EpicGames.Perforce.FromSource.csproj" SetConfiguration="Configuration=$(Configuration)" />
		<!-- Its dependency, which the compiler needs here too: the same files the source build references. -->
		<Reference Include="System.Linq.Async" HintPath="$(UakLinqAsyncDll)" Private="true" Condition="'$(UakLinqAsyncDll)' != ''" />
		<Reference Include="OpenTelemetry.Api" HintPath="$(UakOpenTelemetryDll)" Private="true" Condition="'$(UakOpenTelemetryDll)' != ''" />
	</ItemGroup>

	<Target Name="UakCheckPerforce" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UakPerforceDll)' == '' and '$(UakPerforceFromSource)' != 'true' and '$(UakEngineRoot)' != ''">
		<Error Text="UnrealAgentKit: no prebuilt EpicGames.Perforce.dll in '$(_UakAutomationUtilsDir)$(TargetFramework)/' or '$(_UakAutomationUtilsDir)', and no EpicGames.Perforce source in the engine. Build AutomationTool for that engine first (Engine/Build/BatchFiles/BuildUAT.bat, or BuildUAT.sh on Linux and Mac), or pass -p:UakPerforceDll=&lt;path&gt;." />
	</Target>
</Project>
