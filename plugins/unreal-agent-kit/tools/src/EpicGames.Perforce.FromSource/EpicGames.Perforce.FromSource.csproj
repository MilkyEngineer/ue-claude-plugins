<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Copyright Alex Stevens (@MilkyEngineer). All Rights Reserved.

		Builds EpicGames.Perforce from the engine's own C# source, for engines that ship no prebuilt EpicGames.Perforce.dll:
		a source build whose AutomationTool hasn't been built yet. AgentKit.Vcs uses it only then (EpicGames.Perforce.props).
		The source is read from the engine and compiled into the kit's own tools/bin and tools/obj: nothing is written into the
		engine. It is the engine's code, so the kit's warning and analyzer rules don't apply to it.
	-->
	<PropertyGroup>
		<AssemblyName>EpicGames.Perforce</AssemblyName>
		<RootNamespace>EpicGames.Perforce</RootNamespace>
		<!-- The engine's code, so the engine's version (from its Build.version), not the kit's. -->
		<Version Condition="'$(UakEngineVersion)' != ''">$(UakEngineVersion)</Version>
		<UakPerforceSourceDir>$(UakEngineRoot)Engine/Source/Programs/Shared/EpicGames.Perforce/</UakPerforceSourceDir>
		<UakPerforceFromSource>true</UakPerforceFromSource>
		<EnableDefaultItems>false</EnableDefaultItems>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningLevel>0</WarningLevel>
		<RunAnalyzers>false</RunAnalyzers>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- UakLinqAsyncDll and UakOpenTelemetryDll, from the engine's own builds; it fails early when the source needs one that is missing. -->
	<Import Project="Dependencies.props" />

	<ItemGroup>
		<Compile Include="$(UakPerforceSourceDir)**/*.cs" Exclude="$(UakPerforceSourceDir)obj/**;$(UakPerforceSourceDir)bin/**" />
	</ItemGroup>

	<ItemGroup>
		<!-- EpicGames.Core comes from build/EpicGames.props. Its third-party dependency, whichever this engine version uses. -->
		<Reference Include="System.Linq.Async" HintPath="$(UakLinqAsyncDll)" Private="true" Condition="'$(UakLinqAsyncDll)' != ''" />
		<Reference Include="OpenTelemetry.Api" HintPath="$(UakOpenTelemetryDll)" Private="true" Condition="'$(UakOpenTelemetryDll)' != ''" />
	</ItemGroup>

	<Target Name="UakCheckPerforceSource" BeforeTargets="CoreCompile">
		<Error Condition="!Exists('$(UakPerforceSourceDir)IPerforceConnection.cs')"
			Text="UnrealAgentKit: '$(UakEngineRoot)' has neither a prebuilt EpicGames.Perforce.dll nor its source in '$(UakPerforceSourceDir)'." />
	</Target>
</Project>
