<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>AgentKit.Core</RootNamespace>
		<!-- Core is the shared contract: every public member needs an XML doc comment (CS1591 is an error here). -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<!-- Microsoft.Extensions.Logging.Abstractions is the engine's own copy, from build/EpicGames.props. -->
	<ItemGroup>
		<InternalsVisibleTo Include="AgentKit.Core.Tests" />
		<!-- TargetResolver moved here from AgentKit.Unreal; its tests (StripComments) stayed with the Unreal tests. -->
		<InternalsVisibleTo Include="AgentKit.Unreal.Tests" />
	</ItemGroup>
</Project>
