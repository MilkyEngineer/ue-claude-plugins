* text=auto
# Shell scripts must stay LF even on Windows checkouts with core.autocrlf=true, or sh fails on \r.
*.sh text eol=lf
# The bin/uak shim is sh too, but has no extension.
plugins/unreal-agent-kit/bin/uak text eol=lf
*.py text eol=lf
# cmd.exe mis-parses goto labels in LF-only batch files.
*.cmd text eol=crlf
*.bat text eol=crlf
